# PostgreSQL connection string - used by BOTH the Next.js app and the Python scripts.
# Local example:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/football_data"
# Hosted example (Neon/Supabase/...): paste the connection string they give you.
# Do not add a "?schema=public" suffix - the Python scripts' driver rejects it.
DATABASE_URL=

# API key from https://www.football-data.org/client/register (free tier is enough)
FOOTBALL_API_KEY=
